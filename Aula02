#include <stdio.h>
#include <stdlib.h>

int main(){
    int valores[3];
    float soma = 0;
    float media = 0;
    
    int tamanho = sizeof(valores) / sizeof(valores[0]);    
    
    int i = 0;
    for(i = 0; i < tamanho; i++){
        printf("Digite a nota %d do aluno: ",  1);
        scanf("%d", &valores[i]);
        
        soma += valores[i];
    }
    
    media = soma / tamanho;
    
    printf("Essa e a media do aluno: %.2f\n", media); 
    
    return 0; 
    
}
