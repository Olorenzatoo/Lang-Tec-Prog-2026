void exercicio1() {

    int i, j, posicao, maiorValor;
    int listaNum[100], listaMaior[100], utilizado[100] = {0};

    printf("\n------ Exercicio 1: ------\n");

    for(i = 0; i < 100; i++){
        printf("Escreva o %d numero: ", (i + 1));
        scanf("%d", &listaNum[i]);
    }

    maiorValor = listaNum[0];

    for(i = 0; i < 100; i++){

        for(j = 0; j < 100; j++){
            if(utilizado[j] == 0){
                maiorValor = listaNum[j];
                posicao = j;
                break;
            }
        }

        for(j = 0; j < 100; j++){
            if(utilizado[j] == 0){
                if(maiorValor < listaNum[j]){
                    maiorValor = listaNum[j];
                    posicao = j;
                }
            }
        }

        listaMaior[i] = maiorValor;
        utilizado[posicao] = 1;
    }

    printf("\nNumeros em ordem inversa na qual foram lidos, e ordenados do maior para o menor:\n");

    for(i = 99; i >= 0; i--){
        printf("%d ", listaMaior[i]);
    }
}

void exercicio2() {

    double numInserido;
    int expoente = 0;

    printf("\n------ Exercicio 2: ------\n");

    printf("Escreva um numero real: ");
    scanf("%lf", &numInserido);

    while(numInserido < 1 || numInserido > 10){
        numInserido /= 10;
        expoente++;

    }

    printf("O numero em notacao cientifica e: %lfe+%d", numInserido, expoente);
}

void exercicio3() {

    int i, num, numBinario[7];

    printf("\n------ Exercicio 3: ------\n");

    printf("Escreva um numero: ");
    scanf("%d", &num);

    for(i = 0;i < 7; i++){

        numBinario[i] = num % 2;
        num /= 2;
    }

    for(i = 6; i >= 0; i--){
        printf("%d ", numBinario[i]);
    }
}

void exercicio4() {

    int i, a, b, maiorAB, listaDez[10];

    printf("\n------ Exercicio 4: ------\n");

    for(i = 0; i < 10; i++){
        printf("Escreva o %d numero: ", (i + 1));
        scanf("%d", &listaDez[i]);
    }

    a = listaDez[0];
    b = listaDez[1];
    maiorAB = (a + b + abs(a - b)) / 2;

    for(i = 2; i < 10; i++){

        maiorAB = (maiorAB + listaDez[i] + abs(maiorAB - listaDez[i])) / 2;

    }

    printf("O maior numero eh: %d", maiorAB);
}

int primalidade(int valor){
	
	int j;
	
	for(j = 2;(j * j) <= valor; j++){
			if(valor % j == 0){
				return 0;
			}
	}
	return 1;
}

